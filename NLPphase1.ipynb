#-----NLP Phase 1: Text Processing-------

#text -> cleaning -> tokenization -> stopword removal -> steming/lammetization -> vectorization -> ML

text="I am learning python programming. Python is fast. Isn't it?"
print("Original Text :",text)
print()

#step 1 - lower case
text=text.lower()
print("Step 1: ",text)

#step 2 -remove punctuations- !@#$%^&*().?
import re  #regex- regular expressions

#remove everyhting except letters and spaces
text=re.sub(r'[^\w\s]','',text)
print("Step 2: ",text)

#step 3 : tokenization [Split sentence into words]
tokens=text.split()
print("Step 3: ",tokens)

#step 4 : Remove Stopwords-is,am,are...
stopwords=["is","am","are","the","a"]
filtered_tokens=[x for x in tokens if x not in stopwords]
print("Step 4: ",filtered_tokens)

#step 5 : stemming as lammetization(not possible using simple python)
def stem(word):
  if word.endswith("ing"):
    return word[:-3]
  if word.endswith("ed"):
    return word[:-2]
  return word
stemmed_words=[stem(x) for x in filtered_tokens]
print("Step 5: ",stemmed_words)
